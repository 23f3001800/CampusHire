# Copy to backend/.env for local development.
# backend/.env is gitignored — never commit real credentials.
#
# In production none of this comes from a file: Render injects every value as a
# real environment variable (see render.yaml).

# ── Environment selector ──────────────────────────────────────────────────────
# development -> SQLite, DEBUG on, auto create_all, dev-default secrets
# production  -> requires SECRET_KEY, SECURITY_PASSWORD_SALT and DATABASE_URL,
#                and refuses to boot without them
APP_ENV=development

# ── Secrets (development defaults are built in; set these to override) ────────
# SECRET_KEY=
# SECURITY_PASSWORD_SALT=

# ── Database ──────────────────────────────────────────────────────────────────
# Leave unset locally to use backend/instance/campushire.sqlite3.
# Render supplies a postgres:// URL, which config.py rewrites for SQLAlchemy 2.x.
# DATABASE_URL=postgresql://user:pass@host:5432/campushire

# ── Redis (Celery broker + Flask-Caching) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_URL=redis://localhost:6379/1
CACHE_DEFAULT_TIMEOUT=300

# ── URLs ──────────────────────────────────────────────────────────────────────
# Must include the scheme — these are embedded in outgoing email links.
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# ── Mail (Mailpit locally: `mailpit`, then open http://localhost:8025) ────────
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_DEFAULT_SENDER=noreply@campushire.edu

# ── App identity ──────────────────────────────────────────────────────────────
COLLEGE_NAME=CampusHire
ADMIN_EMAIL=admin@campushire.edu
# Only read by scripts/bootstrap_db.py, and only when no admin exists yet.
# Minimum 12 characters. Required in production.
# ADMIN_PASSWORD=

# Password given to every account created by the dev-only scripts
# (scripts/init_db.py and scripts/seed_data.py). Defaults to a placeholder.
# Both scripts refuse to run when APP_ENV=production.
# SEED_PASSWORD=

# ── Uploads ───────────────────────────────────────────────────────────────────
# Absolute path recommended. Defaults to backend/uploads.
# UPLOAD_FOLDER=
MAX_CONTENT_LENGTH=5242880
