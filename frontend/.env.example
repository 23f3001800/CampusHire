# Copy to .env.development for local work. Vite only exposes VITE_-prefixed vars
# to client code, and inlines them at BUILD time — changing this after a build
# has no effect until you rebuild.
#
# Local development (this is what .env.development already contains):
VITE_API_BASE_URL=http://localhost:5000/api

# Production is NOT read from a committed file. Render injects VITE_API_BASE_URL
# at build time from render.yaml, and real process env vars take priority over
# .env files. That keeps the deployed API host out of the repo, and means a
# stray .env.production can never silently override the deployed value.
#
#   VITE_API_BASE_URL=https://campushire-api.onrender.com/api
